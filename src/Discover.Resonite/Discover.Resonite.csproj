<!-- Remora.Resonite.Sdk version is pinned in global.json (msbuild-sdks). See docs/verification.md B1-B3. -->
<Project Sdk="Remora.Resonite.Sdk">
  <PropertyGroup>
    <ResoniteTarget>client</ResoniteTarget>
    <ResoniteProjectType>mod</ResoniteProjectType>
    <!-- ResoniteModLoader = MonkeyLoader's RML compatibility pack, which is how this install loads RML mods.
         The result is a plain DLL in rml_mods/. -->
    <ResoniteTargetModLoader>ResoniteModLoader</ResoniteTargetModLoader>
    <!-- Off by default: when true, every build copies the DLL into <Resonite>/rml_mods/.
         Install deliberately with: dotnet build src/Discover.Resonite -p:ResoniteInstallOnBuild=true -->
    <ResoniteInstallOnBuild>false</ResoniteInstallOnBuild>
    <RootNamespace>Discover.Resonite</RootNamespace>
    <!-- Mods default to the SDK's bundled publicized refs (2026.8.27.1094 for SDK 2.3.4), which ignore the
         install. Off: compile against the real install's public API (2026.10.29.1239) when ResonitePath
         exists, else the SDK's stripped refs. See verification B1/B2. -->
    <ResoniteUsePublicizedAssemblies>false</ResoniteUsePublicizedAssemblies>
    <Title>ResoniteDiscovery</Title>
    <Authors>Winter</Authors>
    <Description>World discovery screen for the Resonite dash: live sessions and published worlds in ranked, searchable lenses.</Description>
    <Version>0.4.0</Version>
    <!-- Public members here are internal plumbing; the XML-doc warning is noise. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ResoniteReference Include="FrooxEngine" />
    <ResoniteReference Include="FrooxEngine.Store" />
    <ResoniteReference Include="Elements.Core" />
    <ResoniteReference Include="Elements.Assets" />
    <ResoniteReference Include="Renderite.Shared" />
    <ResoniteReference Include="SkyFrost.Base" />
    <ResoniteReference Include="SkyFrost.Base.Models" />
  </ItemGroup>
  <!-- The dash-tab icon (generated by tools/make_icon.py), carried inside the one DLL and imported at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\galaxy-icon.png" LogicalName="Discover.Resonite.Assets.galaxy-icon.png" />
  </ItemGroup>
  <!-- Core's sources are compiled into the mod assembly instead of referenced as a project: RML loads one DLL per
       mod, so the mod stays a single file. Discover.Core.csproj still builds on its own, engine-free, and is what
       the tests exercise. -->
  <ItemGroup>
    <Compile Include="..\Discover.Core\**\*.cs" Exclude="..\Discover.Core\obj\**;..\Discover.Core\bin\**" LinkBase="Core" />
  </ItemGroup>
</Project>
